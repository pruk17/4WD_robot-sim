<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================= -->
  <!--  MESH ROBOT (uses split .glb parts from SwerveDrive_robot).        -->
  <!--                                                                     -->
  <!--  Kinematic chain per corner:                                        -->
  <!--    base_link  =(fixed)=>  Steering  (bracket, does NOT move)        -->
  <!--               =(revolute yaw)=>  drive  (steers about wheel column) -->
  <!--               =(continuous)=>  wheel   (spins / drives)             -->
  <!--                                                                     -->
  <!--  >>> EDIT POSITIONS in the <xacro:swerve_mod .../> calls below <<<  -->
  <!--    sx sy sz = Steering origin (fixed mount point) [m, ROS frame]    -->
  <!--    cx cy    = drive/wheel COLUMN x,y = the STEER (yaw) axis  [m]    -->
  <!--    dz       = drive origin height z  [m]                            -->
  <!--    wz       = wheel axle height z    [m]                            -->
  <!--  ROS frame: +X = forward, +Y = left. mesh_yaw aligns model -Y->+X. -->
  <!-- ================================================================= -->

  <xacro:property name="mesh_pkg" value="package://robot_4wd/meshes"/>
  <xacro:property name="mesh_yaw" value="${pi/2}"/>
  <xacro:property name="base_z"   value="0.1"/>

  <!-- ===================== base_footprint / base_link ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${mesh_yaw}"/>
      <geometry><mesh filename="${mesh_pkg}/Main_body.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.566 0.515 0.143"/></geometry>
    </collision>
    <xacro:inertial_box mass="6.0" x="0.566" y="0.515" z="0.143">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ===================== 2D LiDAR ===================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${0.232 - base_z}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${mesh_yaw}"/>
      <geometry><mesh filename="${mesh_pkg}/2Dlidar.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.027" rpy="0 0 0"/>
      <geometry><cylinder radius="0.032" length="0.054"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" radius="0.032" length="0.054">
      <origin xyz="0 0 0.027" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <pose>0 0 0.03 0 0 0</pose>
      <lidar>
        <scan><horizontal>
          <samples>360</samples><resolution>1</resolution>
          <min_angle>-3.141592</min_angle><max_angle>3.141592</max_angle>
        </horizontal></scan>
        <range><min>0.25</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ===================== ONE swerve module ===================== -->
  <xacro:macro name="swerve_mod" params="prefix MESH sx sy sz cx cy dz wz">

    <!-- (1) FIXED steering bracket: bolted to the body, does NOT move -->
    <joint name="${prefix}_steering_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>
      <origin xyz="${sx} ${sy} ${sz - base_z}" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}_steering_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${mesh_yaw}"/>
        <geometry><mesh filename="${mesh_pkg}/Steering_${MESH}.glb"/></geometry>
      </visual>
      <xacro:inertial_box mass="0.2" x="0.1" y="0.1" z="0.1">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <!-- (2) STEER joint: the drive rotates (yaw) about the wheel column -->
    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_steer_link"/>
      <origin xyz="${cx - sx} ${cy - sy} ${dz - sz}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.15" upper="3.15" effort="80" velocity="20"/>
      <dynamics damping="0.3" friction="0.2"/>
    </joint>
    <link name="${prefix}_steer_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${mesh_yaw}"/>
        <geometry><mesh filename="${mesh_pkg}/drive_${MESH}.glb"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 ${(wz - dz)/2}" rpy="0 0 0"/>
        <geometry><box size="0.1 0.1 0.16"/></geometry>
      </collision>
      <xacro:inertial_box mass="0.6" x="0.1" y="0.1" z="0.16">
        <origin xyz="0 0 ${(wz - dz)/2}" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <!-- (3) DRIVE joint: wheel spins about its axle -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 ${wz - dz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05"/>
    </joint>
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${mesh_yaw}"/>
        <geometry><mesh filename="${mesh_pkg}/wheel_${MESH}.glb"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.064" length="0.05"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.3" radius="0.064" length="0.05">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.2</mu1><mu2>1.2</mu2>
    </gazebo>
  </xacro:macro>

  <!-- ============================================================= -->
  <!--  >>>>>>>>>>>>>  EDIT PART POSITIONS HERE  <<<<<<<<<<<<<        -->
  <!--        sx      sy      sz     cx      cy     dz    wz          -->
  <xacro:swerve_mod prefix="fl" MESH="FL" sx="0.185"  sy="0.188"  sz="0.205" cx="0.26"  cy="0.26"  dz="0.2" wz="0.064"/>
  <xacro:swerve_mod prefix="fr" MESH="FR" sx="0.185"  sy="-0.188" sz="0.205" cx="0.26"  cy="-0.26" dz="0.2" wz="0.064"/>
  <xacro:swerve_mod prefix="bl" MESH="RL" sx="-0.185" sy="0.188"  sz="0.205" cx="-0.26" cy="0.26"  dz="0.2" wz="0.064"/>
  <xacro:swerve_mod prefix="br" MESH="RR" sx="-0.185" sy="-0.188" sz="0.205" cx="-0.26" cy="-0.26" dz="0.2" wz="0.064"/>

</robot>
