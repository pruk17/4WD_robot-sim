<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ Colors (converted to gz visual materials on spawn) ============ -->
  <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
  <material name="blue"><color rgba="0.15 0.35 0.9 1"/></material>
  <material name="dark"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="green"><color rgba="0.2 0.8 0.2 1"/></material>

  <!-- ============ base_footprint: ground-level reference frame ============ -->
  <link name="base_footprint"/>

  <!-- chassis center sits 0.297 m above the ground so the 5" wheels touch z=0 -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.297" rpy="0 0 0"/>
  </joint>

  <!-- ============ base_link: chassis box 0.45 x 0.45 x 0.15 m ============ -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.45 0.45 0.15"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.45 0.45 0.15"/></geometry>
    </collision>
    <xacro:inertial_box mass="6.0" x="0.45" y="0.45" z="0.15">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

</robot>
