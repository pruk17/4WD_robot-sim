<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================= -->
  <!--  ONE swerve module = a steering box (rotates about Z) carrying a  -->
  <!--  drive wheel. Instantiated 4x (one per corner) at the bottom.     -->
  <!--    prefix : fl / fr / bl / br  (must match swerve_controller.py)  -->
  <!--    x, y   : module position relative to base_link center [m]      -->
  <!-- ================================================================= -->
  <xacro:macro name="swerve_module" params="prefix x y">

    <!-- (1) STEER joint: revolute about vertical axis -> chooses wheel heading -->
    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steer_link"/>
      <origin xyz="${x} ${y} -0.15" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.15" upper="3.15" effort="50" velocity="20"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>

    <!-- steering module body: box 0.12 x 0.12 x 0.15 m -->
    <link name="${prefix}_steer_link">
      <visual>
        <geometry><box size="0.12 0.12 0.15"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><box size="0.12 0.12 0.15"/></geometry>
      </collision>
      <xacro:inertial_box mass="0.4" x="0.12" y="0.12" z="0.15">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <!-- (2) DRIVE joint: continuous spin of the wheel -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 -0.0835" rpy="${pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.05"/>
    </joint>

    <!-- wheel: 5" diameter (radius 0.0635 m), 0.05 m wide -->
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry><cylinder radius="0.0635" length="0.05"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.0635" length="0.05"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.25" radius="0.0635" length="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- wheel-ground friction -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
    </gazebo>

  </xacro:macro>

  <!-- ============ instantiate the 4 corners ============ -->
  <!-- x forward (+), y left (+)  per ROS REP-103 -->
  <xacro:swerve_module prefix="fl" x="0.165"  y="0.165"/>
  <xacro:swerve_module prefix="fr" x="0.165"  y="-0.165"/>
  <xacro:swerve_module prefix="bl" x="-0.165" y="0.165"/>
  <xacro:swerve_module prefix="br" x="-0.165" y="-0.165"/>

</robot>
