# ===== colcon / ament build artifacts (regenerated by `colcon build`) =====
/build/
/install/
/log/

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ===== ROS 2 =====
# rosbag2 recordings (can be large — keep out of git)
*.db3
*.mcap
*.bag
rosbag2_*/
# xacro-generated URDF dumps (source of truth is the .xacro)
*.urdf.generated

# ===== Gazebo =====
# local gz cache / downloaded Fuel models if they land in the tree
.gz/
saved_worlds/

# ===== Editors / IDEs =====
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
.clangd/
compile_commands.json

# ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Blender working files (optional) =====
# keep exported .dae/.stl meshes tracked, but ignore Blender autosaves/backups
*.blend1
*.blend2
